# ─── API Configuration ─────────────────────────────────────────────────────────
# Base URL of your deployed backend (e.g. https://clientflow-api.onrender.com/api)
# Leave empty in development — Vite proxy handles /api → localhost:5000
VITE_API_URL=https://your-backend.onrender.com/api

# ─── Socket.io ─────────────────────────────────────────────────────────────────
# Root URL of your backend server (no /api suffix) for Socket.io connection
VITE_SOCKET_URL=https://your-backend.onrender.com
