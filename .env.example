# ─────────────────────────────────────────────────────────────────────────────
# ClientFlow SaaS — Root Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clientflow
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption (for API keys at rest) ───────────────────────────────────────
# Must be exactly 32 characters
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ─── Frontend URL ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Groq is active — add your key to enable AI features
GROQ_API_KEY=

# Placeholders — leave empty until you activate these providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Email (for notifications) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourapp.com

# ─── Integrations (placeholders) ─────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

CLICKUP_API_TOKEN=
MAKE_WEBHOOK_URL=

# ─── Billing (placeholders) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── File Storage ────────────────────────────────────────────────────────────
# Local uploads (default) or S3-compatible
STORAGE_TYPE=local
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
