# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ─── Meta (Facebook / Instagram) ───────────────────────────────────────────────
# Get these from https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Set this to your backend base URL (no trailing slash)
BACKEND_URL=http://localhost:5000
# Custom verify token for Meta webhooks (any random string you choose)
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token

# ─── AI Providers (Priority: Claude → OpenAI → Gemini → Groq) ─────────────────
ANTHROPIC_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
OWNER_EMAIL=your@email.com
OWNER_PASSWORD=your_secure_password

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
