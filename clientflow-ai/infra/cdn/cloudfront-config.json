{
  "Comment": "ClientFlow AI CloudFront distribution with origin failover",
  "CallerReference": "clientflow-ai-2024",
  "Origins": {
    "Quantity": 2,
    "Items": [
      {
        "Id": "PrimaryALB",
        "DomainName": "aws-alb.clientflow-ai.example.com",
        "CustomOriginConfig": {
          "HTTPSPort": 443,
          "HTTPPort": 80,
          "OriginProtocolPolicy": "https-only",
          "OriginSSLProtocols": { "Quantity": 1, "Items": ["TLSv1.2"] },
          "OriginReadTimeout": 30,
          "OriginKeepaliveTimeout": 5
        },
        "ConnectionAttempts": 3,
        "ConnectionTimeout": 10
      },
      {
        "Id": "SecondaryGCP",
        "DomainName": "gcp.clientflow-ai.example.com",
        "CustomOriginConfig": {
          "HTTPSPort": 443,
          "HTTPPort": 80,
          "OriginProtocolPolicy": "https-only",
          "OriginSSLProtocols": { "Quantity": 1, "Items": ["TLSv1.2"] },
          "OriginReadTimeout": 30,
          "OriginKeepaliveTimeout": 5
        },
        "ConnectionAttempts": 3,
        "ConnectionTimeout": 10
      }
    ]
  },
  "OriginGroups": {
    "Quantity": 1,
    "Items": [
      {
        "Id": "FailoverGroup",
        "FailoverCriteria": {
          "StatusCodes": {
            "Quantity": 4,
            "Items": [500, 502, 503, 504]
          }
        },
        "Members": {
          "Quantity": 2,
          "Items": [
            { "OriginId": "PrimaryALB" },
            { "OriginId": "SecondaryGCP" }
          ]
        }
      }
    ]
  },
  "DefaultCacheBehavior": {
    "TargetOriginId": "FailoverGroup",
    "ViewerProtocolPolicy": "redirect-to-https",
    "AllowedMethods": {
      "Quantity": 7,
      "Items": ["GET","HEAD","OPTIONS","PUT","POST","PATCH","DELETE"],
      "CachedMethods": { "Quantity": 2, "Items": ["GET","HEAD"] }
    },
    "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
    "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
    "Compress": true
  },
  "CacheBehaviors": {
    "Quantity": 2,
    "Items": [
      {
        "PathPattern": "/api/*",
        "TargetOriginId": "FailoverGroup",
        "ViewerProtocolPolicy": "https-only",
        "AllowedMethods": {
          "Quantity": 7,
          "Items": ["GET","HEAD","OPTIONS","PUT","POST","PATCH","DELETE"]
        },
        "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
        "DefaultTTL": 0,
        "MaxTTL": 0,
        "MinTTL": 0
      },
      {
        "PathPattern": "/assets/*",
        "TargetOriginId": "PrimaryALB",
        "ViewerProtocolPolicy": "https-only",
        "AllowedMethods": { "Quantity": 2, "Items": ["GET","HEAD"] },
        "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
        "DefaultTTL": 86400,
        "MaxTTL": 31536000,
        "MinTTL": 0,
        "Compress": true
      }
    ]
  },
  "PriceClass": "PriceClass_100",
  "Enabled": true,
  "HttpVersion": "http2and3",
  "IsIPV6Enabled": true,
  "ViewerCertificate": {
    "CloudFrontDefaultCertificate": true,
    "MinimumProtocolVersion": "TLSv1.2_2021"
  },
  "Logging": {
    "Enabled": true,
    "Bucket": "clientflow-ai-cf-logs.s3.amazonaws.com",
    "Prefix": "cdn-logs/"
  }
}
