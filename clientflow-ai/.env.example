# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Active provider: Groq (required)
GROQ_API_KEY=your_groq_api_key

# Disabled placeholders (add keys to enable as fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://clientflow:changeme@localhost:5432/clientflow
POSTGRES_PASSWORD=changeme

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here_make_it_random
OWNER_EMAIL=admin@yourdomain.com
OWNER_PASSWORD=your_secure_password

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
