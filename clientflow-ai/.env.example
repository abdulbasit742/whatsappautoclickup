# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ─── AI Providers (Priority: Claude → OpenAI → Gemini → Groq) ─────────────────
ANTHROPIC_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ─── Meta / Facebook Integration ──────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
FACEBOOK_ACCESS_TOKEN=your_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_REDIRECT_URI=https://yourdomain.com/oauth/meta/callback

# ─── Instagram Integration ─────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://yourdomain.com/oauth/instagram/callback

# ─── Encryption (for API key storage) ─────────────────────────────────────────
# Any string — hashed internally to a 32-byte AES-256 key
ENCRYPTION_KEY=change_this_to_a_long_random_string_in_production

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
OWNER_EMAIL=your@email.com
OWNER_PASSWORD=your_secure_password

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
