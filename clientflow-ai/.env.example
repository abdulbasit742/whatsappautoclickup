# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ─── AI Providers (Priority: Groq → OpenAI → Claude → Gemini) ─────────────────
# Groq is active. Add keys to api_keys table in DB for dynamic rotation.
# These env vars serve as fallback when no DB keys are found.
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_claude_api_key_placeholder
GEMINI_API_KEY=your_gemini_api_key_placeholder

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow

# ─── Redis (BullMQ queue backend) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
OWNER_EMAIL=your@email.com
OWNER_PASSWORD=your_secure_password

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
