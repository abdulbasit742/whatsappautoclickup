# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ─── AI Providers (Priority: Claude → OpenAI → Gemini → Groq) ─────────────────
ANTHROPIC_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_64_chars
JWT_EXPIRES_IN=7d
OWNER_EMAIL=your@email.com
# Production: store a bcrypt hash instead of a plain password.
# Generate with: node -e "require('bcrypt').hash('your_password',12).then(console.log)"
OWNER_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here
# Development fallback only (ignored when OWNER_PASSWORD_HASH is set):
# OWNER_PASSWORD=your_secure_password

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ─── Rate Limiting (requests per window) ───────────────────────────────────────
API_RATE_LIMIT=120          # API requests per 15 min per IP
WEBHOOK_RATE_LIMIT=300      # Webhook requests per 60 sec per IP
BROADCAST_RATE_LIMIT=10     # Broadcast sends per hour per IP

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info              # error | warn | info | http | debug
